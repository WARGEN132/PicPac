# Server configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Security (JWT secret for auth tokens)
JWT_SECRET="picpac-dev-secret-key-change-in-production-2026"

# Database path (relative to app root)
DB_PATH="./data/picpac.db"

# AI Provider: 'mock' (default) | 'openai' | 'local'
AI_PROVIDER="mock"

# Optional: OpenAI API Key and Model (if AI_PROVIDER=openai)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional: Gemini API Key (injected by AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
